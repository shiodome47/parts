{
  "name": "@shiodome47/planner",
  "version": "0.3.1",
  "description": "時間軸（今日・今週・数か月・今年）とプロジェクトの部品。土台（データの形と決まりごと）と、時間軸・プロジェクトの画面（React）",
  "keywords": [
    "planner",
    "todo",
    "habits",
    "timeline",
    "projects",
    "recurring"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiodome47/parts.git",
    "directory": "packages/planner"
  },
  "bugs": {
    "url": "https://github.com/shiodome47/parts/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/timeline.js"
    },
    "./projects": {
      "types": "./dist/projects/index.d.ts",
      "import": "./dist/projects.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "linkshelf": "^0.9.1",
    "lucide-react": "^1.73.0"
  }
}
