{
  "name": "@shiodome47/vision-board",
  "version": "0.2.1",
  "description": "宝地図（ビジョンボード）の部品。画像と言葉を自由に貼り、ピンチで拡大、見え方を覚えて切り替えられる（React）",
  "keywords": [
    "vision-board",
    "moodboard",
    "canvas",
    "pinch-zoom",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiodome47/parts.git",
    "directory": "packages/vision-board"
  },
  "bugs": {
    "url": "https://github.com/shiodome47/parts/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vision-board.js",
  "module": "./dist/vision-board.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vision-board.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.73.0"
  }
}
